# Site file for the DGE-panel pipeline. Copy it to site.env in your project directory (never into
# the package), fill in the values for your machine or cluster, and keep it out of version control.
# The scripts source ${DGE_SITE_ENV:-./site.env} when it exists.

# R environment (both optional). CONDA_SH: path of conda's conda.sh on the machine that runs R
# (~ and $HOME are expanded there). CONDA_ENV: the environment built from env_r.yaml. Leave both
# empty to use the Rscript already on PATH.
CONDA_SH=
CONDA_ENV=

# BLAS kernel policy (set exactly one when this file exists). OpenBLAS built for dynamic
# architecture selection picks a CPU-specific kernel at run time and kernels differ in the last
# bits of floating-point results. Pinning one makes a run reproducible across machines. On a single
# machine it changes nothing. OPENBLAS_CORETYPE pins (x86 only), and DGE_BLAS_PIN=none runs unpinned.
OPENBLAS_CORETYPE=HASWELL
#DGE_BLAS_PIN=none

